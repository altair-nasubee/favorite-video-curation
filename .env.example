# Turso (libSQL)
# ローカル開発では file:./local.db でも可（その場合 TURSO_AUTH_TOKEN は空でよい）
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Better Auth
# openssl rand -base64 32 などで生成
BETTER_AUTH_SECRET="replace-with-random-secret"
# 開発: http://localhost:3000 / 本番: https://your-domain
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console で取得)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
